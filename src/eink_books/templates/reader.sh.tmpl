#!/bin/sh
# Name: __NAME__
# Author: __AUTHOR__
# Description: __DESCRIPTION__
# Icon: __ICON__
# DontUseFBInk

APP_DIR="__APP_DIR__"
PAGES_DIR="$APP_DIR/pages"
PAGE_COUNT=__PAGE_COUNT__
FONT_SIZE=__FONT_SIZE__
SCREEN_W=__SCREEN_W__
LOG="$APP_DIR/reader.log"
RAW="$APP_DIR/.ev.bin"
FLAG="$APP_DIR/.input"
PAGE_FILE="$APP_DIR/.page"
MAX_WAIT=600
REDRAW=60

FBINK="/mnt/us/libkh/bin/fbink"
[ -x "$FBINK" ] || FBINK=$(command -v fbink 2>/dev/null)

KINDLE_FONT="/usr/java/lib/fonts/Caecilia_LT_65_Medium.ttf"
BUNDLED_FONT="$APP_DIR/font.ttf"
if [ -f "$KINDLE_FONT" ]; then
    FONT="$KINDLE_FONT"
elif [ -f "$BUNDLED_FONT" ]; then
    FONT="$BUNDLED_FONT"
else
    FONT=""
fi

log() {
    mkdir -p "$APP_DIR" 2>/dev/null
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG"
}

read_page_index() {
    if [ -f "$PAGE_FILE" ]; then
        cat "$PAGE_FILE"
    else
        echo 1
    fi
}

write_page_index() {
    echo "$1" > "$PAGE_FILE"
}

page_path() {
    printf '%s/%04d.page' "$PAGES_DIR" "$1"
}

show_page() {
    N=$1
    P=$(page_path "$N")
    FOOT=$(printf '%s / %s' "$N" "$PAGE_COUNT")
    FIRST=""
    if [ -f "$P" ]; then
        FIRST=$(sed -n '1p' "$P")
    fi

    if [ -z "$FBINK" ]; then
        if [ -f "$P" ]; then
            cat "$P"
        else
            echo "Missing page $N"
        fi
        echo
        echo "$FOOT"
        return
    fi

    "$FBINK" -c >/dev/null 2>&1
    case "$FIRST" in
        @image:*)
            REL=${FIRST#@image:}
            IMG="$APP_DIR/$REL"
            if [ -f "$IMG" ]; then
                "$FBINK" -g "file=$IMG,w=$SCREEN_W,halign=center,valign=center" >/dev/null 2>&1
            else
                "$FBINK" -y 4 -- "Missing image $REL" >/dev/null 2>&1
            fi
            ;;
        *)
            if [ ! -f "$P" ]; then
                TEXT="Missing page $N"
            else
                TEXT=$(cat "$P")
            fi
            if [ -n "$FONT" ]; then
                printf '%s\n' "$TEXT" | "$FBINK" -t "regular=$FONT,size=$FONT_SIZE,format,top=28,bottom=48,left=28,right=28" >/dev/null 2>&1
            else
                printf '%s\n' "$TEXT" | "$FBINK" -y 2 >/dev/null 2>&1
            fi
            ;;
    esac
    "$FBINK" -y -2 -x 1 -- "$FOOT" >/dev/null 2>&1
}

find_touch_device() {
    D=$(awk '
        $1 == "Section" && $2 == "\"InputDevice\"" { inSec = 1; dev = ""; found = 0 }
        inSec && $2 == "\"Device\"" { dev = $3 }
        inSec && $2 == "\"CorePointer\"" && dev != "" { found = 1 }
        inSec && $1 == "EndSection" {
            if (found && dev != "") { gsub(/"/, "", dev); print dev; exit }
            inSec = 0; dev = ""; found = 0
        }
    ' /etc/xorg.conf 2>/dev/null)
    [ -n "$D" ] && [ -e "$D" ] && { echo "$D"; return; }

    D=$(awk '
        /^N: Name=/ {
            name = $0
            sub(/^N: Name="/, "", name)
            sub(/"$/, "", name)
            ev = ""
        }
        /^H: Handlers=/ {
            for (i = 1; i <= NF; i++) {
                t = $i
                sub(/^Handlers=/, "", t)
                if (t ~ /^event[0-9]+$/) ev = t
            }
        }
        /^B: ABS=/ {
            if (ev != "") {
                if (tolower(name) ~ /(touch|zforce|cyttsp|elan|goodix|ft5|atmel|synaptics|eink|st1232)/) {
                    if (best == "") best = ev
                }
                if (fallback == "") fallback = ev
            }
        }
        END {
            if (best != "") print "/dev/input/" best
            else if (fallback == "") print "/dev/input/" fallback
        }
    ' /proc/bus/input/devices 2>/dev/null)
    [ -n "$D" ] && [ -e "$D" ] && { echo "$D"; return; }

    for D in /dev/input/event1 /dev/input/event0 /dev/input/event2; do
        [ -e "$D" ] && { echo "$D"; return; }
    done
}

find_key_device() {
    D=$(awk '
        /^N: Name=/ {
            name = $0
            sub(/^N: Name="/, "", name)
            sub(/"$/, "", name)
            ev = ""
        }
        /^H: Handlers=/ {
            for (i = 1; i <= NF; i++) {
                t = $i
                sub(/^Handlers=/, "", t)
                if (t ~ /^event[0-9]+$/) ev = t
            }
        }
        /^B: KEY=/ {
            if (ev != "" && tolower(name) ~ /(key|button|gpio|yoshi|eink)/) {
                if (best == "") best = ev
            }
        }
        END {
            if (best != "") print "/dev/input/" best
        }
    ' /proc/bus/input/devices 2>/dev/null)
    [ -n "$D" ] && [ -e "$D" ] && { echo "$D"; return; }
}

# 16-byte input_event on the Kindle (32-bit). type at short 5, code at 6.
# Falls back to NEXT when the dump has no usable ABS/KEY.
parse_gesture() {
    od -An -v -t u2 "$1" 2>/dev/null | awk -v sw="$SCREEN_W" '
    {
        for (i = 1; i + 7 <= NF; i += 8) {
            type = $(i + 4) + 0
            code = $(i + 5) + 0
            val  = $(i + 6) + 0
            if (type == 1 && val == 1) {
                if (code == 104 || code == 103 || code == 105 || code == 115) { print "PREV"; exit }
                if (code == 109 || code == 108 || code == 106 || code == 114) { print "NEXT"; exit }
                if (code == 158 || code == 1) { print "QUIT"; exit }
            }
            if (type == 3 && code == 0) x = val
            if (type == 3 && code == 1) y = val
        }
    }
    END {
        if (x == "") { print "NEXT"; exit }
        maxx = (x > 6000) ? 4095 : ((sw > 0) ? sw : 600)
        if (maxx < 1) maxx = 4095
        if (x > 6000) maxx = 4095
        if (y != "" && y < (maxx * 0.12) && x < (maxx * 0.22)) { print "QUIT"; exit }
        if (x < (maxx * 0.34)) { print "PREV"; exit }
        print "NEXT"
    }
    '
}

wait_for_gesture() {
    TOUCH=$(find_touch_device)
    KEYS=$(find_key_device)
    DEV="$TOUCH"
    [ -z "$DEV" ] && DEV="$KEYS"
    if [ -z "$DEV" ]; then
        log "no input device; holding 4s then NEXT"
        sleep 4
        echo NEXT
        return
    fi

    rm -f "$RAW" "$FLAG"
    dd if="$DEV" of="$RAW" bs=16 count=12 >/dev/null 2>&1 && touch "$FLAG" &
    JOB=$!

    N=0
    while [ ! -f "$FLAG" ]; do
        sleep 1
        N=$((N + 1))
        [ $((N % REDRAW)) -eq 0 ] && show_page "$(read_page_index)"
        if [ "$N" -ge "$MAX_WAIT" ]; then
            log "timeout after ${MAX_WAIT}s"
            kill "$JOB" 2>/dev/null
            echo QUIT
            wait "$JOB" 2>/dev/null
            rm -f "$FLAG" "$RAW"
            return
        fi
    done

    wait "$JOB" 2>/dev/null
    if [ -s "$RAW" ]; then
        parse_gesture "$RAW"
    else
        echo NEXT
    fi
    rm -f "$FLAG" "$RAW"
}

leave() {
    [ -n "$FBINK" ] && "$FBINK" -c >/dev/null 2>&1
    lipc-set-prop com.lab126.appmgrd start app://com.lab126.booklet.home >/dev/null 2>&1
}

mkdir -p "$APP_DIR"
PAGE=$(read_page_index)
[ "$PAGE" -ge 1 ] 2>/dev/null || PAGE=1
[ "$PAGE" -le "$PAGE_COUNT" ] || PAGE=1
write_page_index "$PAGE"

log "open page $PAGE / $PAGE_COUNT font=$FONT"
show_page "$PAGE"

while :; do
    GESTURE=$(wait_for_gesture)
    log "gesture $GESTURE on page $PAGE"
    case "$GESTURE" in
        QUIT)
            break
            ;;
        PREV)
            if [ "$PAGE" -gt 1 ]; then
                PAGE=$((PAGE - 1))
                write_page_index "$PAGE"
                show_page "$PAGE"
            fi
            ;;
        *)
            if [ "$PAGE" -ge "$PAGE_COUNT" ]; then
                break
            fi
            PAGE=$((PAGE + 1))
            write_page_index "$PAGE"
            show_page "$PAGE"
            ;;
    esac
done

leave
